{
    "python.defaultInterpreterPath": "${workspaceFolder}/.DisloClusterVenv/Scripts/python.exe",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/ZrMicro"
    ],
    "cmake.sourceDirectory": "${workspaceFolder}/ZrMicro/cpp_utils",
    "cmake.buildDirectory": "${workspaceFolder}/ZrMicro/build",
    "files.watcherExclude": {
        "**/.DisloClusterVenv/**": true,
        "**/MoDELib3/build/**": true,
        "**/ZrMicro/build/**": true
    },
    "jupyter.kernels.excludePythonEnvironments": [
        "${workspaceFolder}/.DisloClusterVenv/Scripts/python.exe"
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "texify",
            "command": "C:\\Users\\Owner\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\texify.exe",
            "args": [
                "--pdf",
                "--synctex=1",
                "--tex-option=-interaction=nonstopmode",
                "--tex-option=-file-line-error",
                "%DOC_EXT%"
            ],
            "env": {}
        },
        {
            "name": "pdflatex",
            "command": "C:\\Users\\Owner\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\pdflatex.exe",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "bibtex",
            "command": "C:\\Users\\Owner\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\bibtex.exe",
            "args": [
                "%DOCFILE%"
            ],
            "env": {}
        },
        {
            "name": "latexmk",
            "command": "C:\\Users\\Owner\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\latexmk.exe",
            "args": [
                "-cd",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "texify (MiKTeX, no perl)",
            "tools": [
                "texify"
            ]
        },
        {
            "name": "pdflatex x2 + bibtex",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "latexmk (needs perl)",
            "tools": [
                "latexmk"
            ]
        }
    ],
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.autoClean.run": "never"
}
