\@writefile{toc}{\contentsline {section}{\numberline {5}Results}{31}{section.5}\protected@file@percent }
\newlabel{sec:resultsAll}{{5}{31}{Results}{section.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}The \texttt  {ZrMicro-0d} code results}{31}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces First-round optimum: model (lines, color $=T$) versus experiment (markers, $\pm 20\%$). (a) $a$-loop density saturates at $\sim \!1$--$2\times 10^{22}\,\si {\per \cubic \metre }$, matching the dense $473$--$623\,$K cluster and the annealed high-$T$ tail. (b) $a$-loop diameter saturates near $10$--$15\,$nm, consistent with the low/mid-$T$ data; the large $33$--$62\,$nm points at $668$--$673\,$K are the excluded vacancy-character ``$a$'' loops. (c) $c$-loop density saturates near $1.3\times 10^{21}\,\si {\per \cubic \metre }$, matching Tournadre ($583\,$K) and bracketing the Harte ($573\,$K) points. (d) $c$-loop diameter saturates at $\sim \!70\,$nm versus the measured $95$--$150\,$nm --- the model under-predicts $c$-loop size by $\sim \!1.5$--$2\times $, the principal remaining discrepancy and the motivation for the targeted $c$-loop refit in \texttt  {fit\_cloops.py}.}}{32}{figure.4}\protected@file@percent }
\newlabel{fig:parity}{{4}{32}{First-round optimum: model (lines, color $=T$) versus experiment (markers, $\pm 20\%$). (a) $a$-loop density saturates at $\sim \!1$--$2\times 10^{22}\,\si {\per \cubic \metre }$, matching the dense $473$--$623\,$K cluster and the annealed high-$T$ tail. (b) $a$-loop diameter saturates near $10$--$15\,$nm, consistent with the low/mid-$T$ data; the large $33$--$62\,$nm points at $668$--$673\,$K are the excluded vacancy-character ``$a$'' loops. (c) $c$-loop density saturates near $1.3\times 10^{21}\,\si {\per \cubic \metre }$, matching Tournadre ($583\,$K) and bracketing the Harte ($573\,$K) points. (d) $c$-loop diameter saturates at $\sim \!70\,$nm versus the measured $95$--$150\,$nm --- the model under-predicts $c$-loop size by $\sim \!1.5$--$2\times $, the principal remaining discrepancy and the motivation for the targeted $c$-loop refit in \texttt {fit\_cloops.py}}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Point-defect evolution. Free vacancies ($C_v$) saturate near $5\times 10^{17}\,\si {\per \cubic \centi \metre }$ while free interstitials ($C_i$) sit well below them; the di-/tri-interstitial channels remain negligible. The interstitial content of $a$-loops and the vacancy content of $c$-loops grow by several orders of magnitude before saturating, showing that the retained damage is overwhelmingly stored in the loop population.}}{33}{figure.5}\protected@file@percent }
\newlabel{fig:point_defects}{{5}{33}{Point-defect evolution. Free vacancies ($C_v$) saturate near $5\times 10^{17}\,\si {\per \cubic \centi \metre }$ while free interstitials ($C_i$) sit well below them; the di-/tri-interstitial channels remain negligible. The interstitial content of $a$-loops and the vacancy content of $c$-loops grow by several orders of magnitude before saturating, showing that the retained damage is overwhelmingly stored in the loop population}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Total stored-defect evolution versus dose, showing the early build-up, the mild overshoot near $10^{-2}\,$dpa, and the saturation plateau that is inherited by all downstream microstructural quantities.}}{34}{figure.6}\protected@file@percent }
\newlabel{fig:total_defect_evolution}{{6}{34}{Total stored-defect evolution versus dose, showing the early build-up, the mild overshoot near $10^{-2}\,$dpa, and the saturation plateau that is inherited by all downstream microstructural quantities}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Partition of the interstitial (left) and vacancy (right) budgets between the randomly oriented and DAD-aligned loop populations. The aligned fractions settle to the values fixed by the orientation bias, supplying the directional sink strength that drives growth.}}{34}{figure.7}\protected@file@percent }
\newlabel{fig:interstitial_fractions}{{7}{34}{Partition of the interstitial (left) and vacancy (right) budgets between the randomly oriented and DAD-aligned loop populations. The aligned fractions settle to the values fixed by the orientation bias, supplying the directional sink strength that drives growth}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Net vacancy--interstitial imbalance arriving at the sinks. The sign-definite, saturating imbalance is the microscopic driver of the macroscopic growth strain.}}{35}{figure.8}\protected@file@percent }
\newlabel{fig:defect_imbalance}{{8}{35}{Net vacancy--interstitial imbalance arriving at the sinks. The sign-definite, saturating imbalance is the microscopic driver of the macroscopic growth strain}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Defect fluxes to the sinks. Left: the absolute vacancy and interstitial fluxes rise during the transient and saturate together. Right: the small, sign-definite net flux produced by the orientation bias, which controls the growth rate.}}{35}{figure.9}\protected@file@percent }
\newlabel{fig:flux_evolution}{{9}{35}{Defect fluxes to the sinks. Left: the absolute vacancy and interstitial fluxes rise during the transient and saturate together. Right: the small, sign-definite net flux produced by the orientation bias, which controls the growth rate}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Dislocation-loop number density versus dose (model lines; experimental points with $\pm 20\%$ bars). Interstitial and vacancy loops, each with their DAD-aligned subset, nucleate, overshoot near $2\times 10^{-2}\,$dpa, and saturate. The $a$-loop plateau sits at the lower edge of the measured $1$--$3\times 10^{22}\,\si {\per \cubic \metre }$ band.}}{36}{figure.10}\protected@file@percent }
\newlabel{fig:loop_density}{{10}{36}{Dislocation-loop number density versus dose (model lines; experimental points with $\pm 20\%$ bars). Interstitial and vacancy loops, each with their DAD-aligned subset, nucleate, overshoot near $2\times 10^{-2}\,$dpa, and saturate. The $a$-loop plateau sits at the lower edge of the measured $1$--$3\times 10^{22}\,\si {\per \cubic \metre }$ band}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Loop diameter versus dose. The $a$-loop (interstitial) diameter saturates near $9$--$10\,$nm in agreement with the low/mid-$T$ data; the $c$-loop (vacancy) diameter saturates near $70\,$nm, below the measured $95$--$150\,$nm, the main remaining discrepancy.}}{37}{figure.11}\protected@file@percent }
\newlabel{fig:loop_diameter_vs_dose}{{11}{37}{Loop diameter versus dose. The $a$-loop (interstitial) diameter saturates near $9$--$10\,$nm in agreement with the low/mid-$T$ data; the $c$-loop (vacancy) diameter saturates near $70\,$nm, below the measured $95$--$150\,$nm, the main remaining discrepancy}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Decomposition of the saturated loop population by family and orientation, showing that interstitial loops control the number density while vacancy loops control the stored defect volume.}}{37}{figure.12}\protected@file@percent }
\newlabel{fig:loop_density_analysis}{{12}{37}{Decomposition of the saturated loop population by family and orientation, showing that interstitial loops control the number density while vacancy loops control the stored defect volume}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Interstitial ($a$) loops versus the temperature-resolved database. Left: number density; the saturation level falls with increasing temperature, tracking the measured thermal suppression. Right: diameter, saturating near $8$--$11\,$nm; the large high-$T$ points are excluded vacancy-character loops.}}{38}{figure.13}\protected@file@percent }
\newlabel{fig:aloop_density_vs_experiment}{{13}{38}{Interstitial ($a$) loops versus the temperature-resolved database. Left: number density; the saturation level falls with increasing temperature, tracking the measured thermal suppression. Right: diameter, saturating near $8$--$11\,$nm; the large high-$T$ points are excluded vacancy-character loops}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Vacancy ($c$) loops versus experiment. Left: the density saturates near $1.3\times 10^{21}\,\si {\per \cubic \metre }$, matching Tournadre and bracketing Harte. Right: the diameter saturates below the measured $95$--$150\,$nm, the main residual discrepancy.}}{38}{figure.14}\protected@file@percent }
\newlabel{fig:cloop_density_vs_experiment}{{14}{38}{Vacancy ($c$) loops versus experiment. Left: the density saturates near $1.3\times 10^{21}\,\si {\per \cubic \metre }$, matching Tournadre and bracketing Harte. Right: the diameter saturates below the measured $95$--$150\,$nm, the main residual discrepancy}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Evolution of the network dislocation density $\rho _N$, which relaxes from its grown-in seed and saturates as unfaulted loops feed the network and coalescence limits further growth.}}{39}{figure.15}\protected@file@percent }
\newlabel{fig:network_density_evolution}{{15}{39}{Evolution of the network dislocation density $\rho _N$, which relaxes from its grown-in seed and saturates as unfaulted loops feed the network and coalescence limits further growth}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Mean loop-to-network (left) and loop-to-loop (right) spacings. Both contract as the loop density builds and saturate at the inter-obstacle distance that governs hardening and coalescence.}}{39}{figure.16}\protected@file@percent }
\newlabel{fig:loop_network_spacing}{{16}{39}{Mean loop-to-network (left) and loop-to-loop (right) spacings. Both contract as the loop density builds and saturate at the inter-obstacle distance that governs hardening and coalescence}{figure.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The {\textsf  {MoDELib2-NG}} code results}{39}{subsection.5.2}\protected@file@percent }
\newlabel{sec:results}{{5.2}{39}{The {\MoDNG } code results}{subsection.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Interstitial (left) and vacancy (right) conservation channels. Production is balanced by recombination plus absorption at the sinks at every dose, confirming closure of the defect budget.}}{40}{figure.17}\protected@file@percent }
\newlabel{fig:conservation_channels_i}{{17}{40}{Interstitial (left) and vacancy (right) conservation channels. Production is balanced by recombination plus absorption at the sinks at every dose, confirming closure of the defect budget}{figure.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Running relative error in the global defect balance, which remains at the round-off level over the full dose range, establishing that the reported transients and plateau are physical rather than numerical.}}{40}{figure.18}\protected@file@percent }
\newlabel{fig:conservation_error}{{18}{40}{Running relative error in the global defect balance, which remains at the round-off level over the full dose range, establishing that the reported transients and plateau are physical rather than numerical}{figure.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Ratio of {\textsf  {MoDELib2-NG}} interior values to {\texttt  {ZrMicro-0d}}, as a function of dose.}}{41}{table.8}\protected@file@percent }
\newlabel{tab:verification}{{8}{41}{Ratio of {\MoDNG } interior values to {\ZrOd }, as a function of dose}{table.8}{}}
\newlabel{eq:depletion}{{150}{41}{The {\MoDNG } code results}{equation.150}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Mobile defect concentrations $C_v$, $C_i$, $C_{2i}$ and $C_{3i}$ on an interior mid-plane cut, at 1, 5, 10 and 30 dpa. The color scale is logarithmic over three decades below the maximum, which places the color range across the depletion shell rather than on the interior plateau. The depleted layer thickens with dose as the loop sink strength grows.}}{42}{figure.19}\protected@file@percent }
\newlabel{fig:mobile}{{19}{42}{Mobile defect concentrations $C_v$, $C_i$, $C_{2i}$ and $C_{3i}$ on an interior mid-plane cut, at 1, 5, 10 and 30 dpa. The color scale is logarithmic over three decades below the maximum, which places the color range across the depletion shell rather than on the interior plateau. The depleted layer thickens with dose as the loop sink strength grows}{figure.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Loop number density for the basal \ensuremath  {\langle c\rangle }{} family and the three prismatic \ensuremath  {\langle a\rangle }{} families. At zero applied stress the three \ensuremath  {\langle a\rangle }{} panels must be identical, and are; this is a check on the crystallography. Note the accumulation adjacent to the grain boundary.}}{43}{figure.20}\protected@file@percent }
\newlabel{fig:idens}{{20}{43}{Loop number density for the basal \cloop {} family and the three prismatic \aloop {} families. At zero applied stress the three \aloop {} panels must be identical, and are; this is a check on the crystallography. Note the accumulation adjacent to the grain boundary}{figure.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Stored defect content of the four loop families. The \ensuremath  {\langle a\rangle }{} families are \emph  {enhanced} at the boundary, where the density excess outweighs the size deficit; the \ensuremath  {\langle c\rangle }{} family is \emph  {depleted} there, its density being almost uniform in space so that the size deficit is unopposed.}}{44}{figure.21}\protected@file@percent }
\newlabel{fig:icont}{{21}{44}{Stored defect content of the four loop families. The \aloop {} families are \emph {enhanced} at the boundary, where the density excess outweighs the size deficit; the \cloop {} family is \emph {depleted} there, its density being almost uniform in space so that the size deficit is unopposed}{figure.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Basal \ensuremath  {\langle c\rangle }{} vacancy loop population. Platelets lie in the basal plane, consistent with the $\langle c\rangle $ Burgers vector.}}{45}{figure.22}\protected@file@percent }
\newlabel{fig:loopsc}{{22}{45}{Basal \cloop {} vacancy loop population. Platelets lie in the basal plane, consistent with the $\langle c\rangle $ Burgers vector}{figure.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces One of the three prismatic \ensuremath  {\langle a\rangle }{} interstitial loop families. The habit plane differs from Fig.~\ref {fig:loopsc}, as it must.}}{45}{figure.23}\protected@file@percent }
\newlabel{fig:loopsa}{{23}{45}{One of the three prismatic \aloop {} interstitial loop families. The habit plane differs from Fig.~\ref {fig:loopsc}, as it must}{figure.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces Mobile defect concentrations against distance from the grain boundary. The recovery length is the depletion length $\ell \approx 73~nm$; beyond roughly 300~nm the profiles are flat, confirming that the interior is well mixed.}}{45}{figure.24}\protected@file@percent }
\newlabel{fig:gbmob}{{24}{45}{Mobile defect concentrations against distance from the grain boundary. The recovery length is the depletion length $\ell \approx 73~nm$; beyond roughly 300~nm the profiles are flat, confirming that the interior is well mixed}{figure.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces Loop number density against distance from the grain boundary. The \ensuremath  {\langle a\rangle }{} families rise by more than three orders of magnitude within the first few tens of nanometres.}}{46}{figure.25}\protected@file@percent }
\newlabel{fig:gbdens}{{25}{46}{Loop number density against distance from the grain boundary. The \aloop {} families rise by more than three orders of magnitude within the first few tens of nanometres}{figure.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces Stored defect content against distance from the grain boundary.}}{46}{figure.26}\protected@file@percent }
\newlabel{fig:gbcont}{{26}{46}{Stored defect content against distance from the grain boundary}{figure.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces Mean loop diameter against distance from the grain boundary. The diameter is formed from the binned mean content and density, not by averaging nodal diameters: size is a ratio of two fields, and the mean of a ratio is not the ratio of the means.}}{46}{figure.27}\protected@file@percent }
\newlabel{fig:gbsize}{{27}{46}{Mean loop diameter against distance from the grain boundary. The diameter is formed from the binned mean content and density, not by averaging nodal diameters: size is a ratio of two fields, and the mean of a ratio is not the ratio of the means}{figure.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Mesh-dependence studies. Left: cubic verification domain, 281{,}218 tetrahedra, graded from 29~nm in the 150~nm boundary layer to 147~nm in the interior (cut plane facing the viewer). Right: hexagonal Zr single crystal, 400~nm wide by 653~nm tall, 20{,}726 tetrahedra (cut normal to $y$).}}{47}{figure.28}\protected@file@percent }
\newlabel{fig:mesh-dependence}{{28}{47}{Mesh-dependence studies. Left: cubic verification domain, 281{,}218 tetrahedra, graded from 29~nm in the 150~nm boundary layer to 147~nm in the interior (cut plane facing the viewer). Right: hexagonal Zr single crystal, 400~nm wide by 653~nm tall, 20{,}726 tetrahedra (cut normal to $y$)}{figure.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces $\langle a \rangle _3$ loop size distributions at 1~dpa (left) and 26~dpa (right). The number-weighted mean diameter is nearly dose-independent while the number density grows by more than an order of magnitude, the signature of a nucleation-dominated population.}}{48}{figure.29}\protected@file@percent }
\newlabel{fig:size-dist-a}{{29}{48}{$\langle a \rangle _3$ loop size distributions at 1~dpa (left) and 26~dpa (right). The number-weighted mean diameter is nearly dose-independent while the number density grows by more than an order of magnitude, the signature of a nucleation-dominated population}{figure.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces $\langle c \rangle $ loop size distributions at 1~dpa (left) and 26~dpa (right). The interior population coarsens slowly with dose while a stationary near-boundary population remains near 20~nm; the number-weighted mean moves from 46.0 to 48.5~nm.}}{48}{figure.30}\protected@file@percent }
\newlabel{fig:size-dist-c}{{30}{48}{$\langle c \rangle $ loop size distributions at 1~dpa (left) and 26~dpa (right). The interior population coarsens slowly with dose while a stationary near-boundary population remains near 20~nm; the number-weighted mean moves from 46.0 to 48.5~nm}{figure.30}{}}
\newlabel{sec:summary}{{5.2}{48}{The {\MoDNG } code results}{figure.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces Loop populations in the unstressed hexagonal single crystal at 6~dpa; platelet radii are magnified ($7\times $ prismatic, $1.5\times $ basal) and are not to scale. Top row and bottom left: the three prismatic $\langle a \rangle $ families, whose statistical equivalence at zero stress is the built-in crystallography check. Bottom right: the basal $\langle c \rangle $ family, physically much larger and denuded within the boundary depletion layer.}}{49}{figure.31}\protected@file@percent }
\newlabel{fig:loops-6dpa}{{31}{49}{Loop populations in the unstressed hexagonal single crystal at 6~dpa; platelet radii are magnified ($7\times $ prismatic, $1.5\times $ basal) and are not to scale. Top row and bottom left: the three prismatic $\langle a \rangle $ families, whose statistical equivalence at zero stress is the built-in crystallography check. Bottom right: the basal $\langle c \rangle $ family, physically much larger and denuded within the boundary depletion layer}{figure.31}{}}
